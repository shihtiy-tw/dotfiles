{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // https://github.com/jenslys/opencode-gemini-auth
    "opencode-gemini-auth@latest",
    // "@tarquinen/opencode-dcp@latest"
  ],
  "permission": {
    "skill": {
      "obsidian-skills": "allow",
      "anthropics-skill-creator": "allow",
      "context-engineering": "allow",
      "mermaidjs-v11": "allow",
      "superpower-brainstorming": "allow",
      "librarian": "allow",
      "planning-advisor": "allow",
      "spec-architect": "allow",
      "triage-officer": "allow",
      "*": "deny",
    }
  },
  "mcp": {
    "readwise": {
      "command": [
        "npx",
        "@readwise/readwise-mcp"
      ],
      "type": "local",
      "enabled": true,
      "environment": {
        "ACCESS_TOKEN": "{env:READWISE_TOKEN}"
      }
    }
  },
  "theme": "everforest",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B"
        },
        "qwen3:4b": {
          "name": "Qwen 3 4B"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        }
      }
    },
    "google": {
      "models": {
        "gemini-2.5-flash": {
          "options": {
            "thinkingConfig": {
              "thinkingBudget": 8192,
              "includeThoughts": true
            }
          }
        },
        "gemini-2.5-pro": {
          "options": {
            "thinkingConfig": {
              "thinkingBudget": 8192,
              "includeThoughts": true
            }
          }
        },
        "gemini-3-flash-preview": {
          "options": {
            "thinkingConfig": {
              "thinkingLevel": "high",
              "includeThoughts": true
            }
          }
        },
        "gemini-3-pro-preview": {
          "options": {
            "thinkingConfig": {
              "thinkingLevel": "high",
              "includeThoughts": true
            }
          }
        }
      }
    }
  }
}
