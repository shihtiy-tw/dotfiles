{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest", "oh-my-opencode@3.5.2", "@plannotator/opencode@latest"],
  "permission": {
    "skill": {
      "obsidian-skills": "allow",
      "anthropics-skill-creator": "allow",
      "cloudekit-context-engineering": "allow",
      "cloudekit-sequential-thinking": "allow",
      "cloudekit-mermaidjs-v11": "allow",
      "superpower-brainstorming": "allow",
      "librarian": "allow",
      "planning-advisor": "allow",
      "spec-architect": "allow",
      "triage-officer": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "readwise": {
      "command": ["npx", "@readwise/readwise-mcp"],
      "type": "local",
      "enabled": true,
      "environment": {
        "ACCESS_TOKEN": "{env:READWISE_TOKEN}"
      }
    },
    "sequential-thinking": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "type": "local",
      "enabled": true
    },
    "notebooklm-mcp": {
      "command": ["uvx", "--from", "notebooklm-mcp-cli", "notebooklm-mcp"],
      "type": "local",
      "enabled": true
    },
    "vibe_kanban": {
      "type": "local",
      "command": ["npx", "-y", "vibe-kanban@latest", "--mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY",
        "Accept": "application/json, text/event-stream"
      },
      "enabled": true
    }
  },
  "theme": "everforest",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B"
        },
        "qwen3:4b": {
          "name": "Qwen 3 4B"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        }
      }
    },
    "google": {
      "name": "Google",
      "models": {
        "gemini-2.5-flash": {
          "options": {
            "thinkingConfig": {
              "thinkingBudget": 8192,
              "includeThoughts": true
            }
          }
        },
        "gemini-2.5-pro": {
          "options": {
            "thinkingConfig": {
              "thinkingBudget": 8192,
              "includeThoughts": true
            }
          }
        },
        "gemini-3-flash-preview": {
          "options": {
            "thinkingConfig": {
              "thinkingLevel": "high",
              "includeThoughts": true
            }
          }
        },
        "gemini-3-pro-preview": {
          "options": {
            "thinkingConfig": {
              "thinkingLevel": "high",
              "includeThoughts": true
            }
          }
        }
      }
    }
  }
}
