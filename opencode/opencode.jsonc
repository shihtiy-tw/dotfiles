{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "@plannotator/opencode@latest"
  ],
  "permission": {
    "skill": {
      "obsidian-skills": "allow",
      "anthropics-skill-creator": "allow",
      "cloudekit-context-engineering": "allow",
      "cloudekit-sequential-thinking": "allow",
      "cloudekit-mermaidjs-v11": "allow",
      "superpower-brainstorming": "allow",
      "librarian": "allow",
      "planning-advisor": "allow",
      "spec-architect": "allow",
      "triage-officer": "allow",
      "*": "deny"
    }
  },
  "mcp": {
    "graphthulhu": {
      "command": [
        "/home/yst/.local/bin/graphthulhu",
        "serve",
        "--backend", "obsidian",
        "--vault", "/home/yst/Brainiverse/Brainiverse",
        "--read-only"
      ],
      "type": "local",
      "enabled": true
    },
    "readwise": {
      "command": [
        "npx",
        "@readwise/readwise-mcp"
      ],
      "type": "local",
      "enabled": true,
      "environment": {
        "ACCESS_TOKEN": "{env:READWISE_TOKEN}"
      }
    },
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "type": "local",
      "enabled": true
    },
    "notebooklm-mcp": {
      "command": [
        "uvx",
        "--from",
        "notebooklm-mcp-cli",
        "notebooklm-mcp"
      ],
      "type": "local",
      "enabled": true
    },
    "notebooklm": {
      "command": ["/home/yst/.local/bin/notebooklm-mcp"],
      "type": "local",
      "enabled": true
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "type": "remote",
      "enabled": true
    },
    "consensus": {
      "url": "https://mcp.consensus.app/mcp",
      "type": "remote",
      "auth": "oauth",
      "oauthRedirectUrl": "http://127.0.0.1:44647/callback",
      "enabled": true
    },
    "postgres": {
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "postgresql://homelab:{env:HOMELAB_PG_PASSWORD}@172.20.0.3:5432/homelab"],
      "type": "local",
      "enabled": true
    },
  },
  "model": "amazon-bedrock/global.anthropic.claude-sonnet-4-6",
  "theme": "everforest",
  "provider": {
    "amazon-bedrock": {
      "models": {
        "us.anthropic.claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Bedrock US)"
        },
        "global.anthropic.claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Bedrock Global)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen 2.5 Coder 32B"
        },
        "qwen3:4b": {
          "name": "Qwen 3 4B"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        }
      }
    },
    "google": {
      "name": "Google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        }
      }
    }
  }
}
