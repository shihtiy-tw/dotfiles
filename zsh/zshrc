# ~/.zshrc - interactive shell setup.
#
# Load order matters:
#   1. path/fpath hygiene    before anything appends to them
#   2. env.zsh               tools must be on PATH for steps 3+
#   3. completion-cache.zsh  writes $ZSH_COMPCACHE/_tool, must precede compinit
#   4. omzsh.zsh             oh-my-zsh, which runs the one and only compinit
#   5. the rest              anything that binds keys or wraps ZLE widgets

# Amazon Q pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh"

# Keep path/fpath duplicate-free. Without this, every nested interactive shell
# (a tmux pane, `zsh` inside `zsh`) re-appends the whole set: 24 -> 46 -> 68
# entries measured three levels deep.
typeset -gU path fpath

# PATH must be exported before anything shells out to rebuild it. `pyenv init`
# pipes $PATH through `bash --norc -ec`; if PATH is not in the environment that
# helper sees an empty value, falls back to bash's compiled-in default, and hands
# back a PATH with every earlier entry (/bin, ~/.local/bin, ...) silently dropped.
export PATH

# Overridable so a checkout elsewhere (a worktree, CI) can be exercised without
# touching the installed config.
export DOTFILES="${DOTFILES:-${HOME}/dotfiles}"
export DOTFILE="$DOTFILES" # legacy name; make/ and newer code use DOTFILES

path=("${HOME}/bin"(N-/) /usr/local/bin(N-/) $path)

# Cached completion functions. Must join fpath before compinit runs.
export ZSH_COMPCACHE="${HOME}/.zsh.d"
[[ -d $ZSH_COMPCACHE ]] || mkdir -p "$ZSH_COMPCACHE"
fpath=("$ZSH_COMPCACHE" $fpath)

export ZSH="${HOME}/.oh-my-zsh"

source "$DOTFILES/zsh/env.zsh"
source "$DOTFILES/zsh/completion-cache.zsh"
source "$DOTFILES/zsh/omzsh.zsh"

source "$DOTFILES/zsh/config.zsh"
source "$DOTFILES/zsh/alias.zsh"
source "$DOTFILES/zsh/function.zsh"
source "$DOTFILES/zsh/completion.zsh"
source "$DOTFILES/zsh/man.zsh"

# THEME: generated by `make dark` / `make light` (make/color-theme.sh) and
# gitignored, so it is absent on a fresh clone until a theme is first selected.
[[ -f "$DOTFILES/zsh/theme.zsh" ]] && source "$DOTFILES/zsh/theme.zsh"

# fzf: prefer the built-in integration (fzf >= 0.48), fall back to the file the
# git installer drops. One `fzf --zsh` call, not three sources.
if (( $+commands[fzf] )); then
  _fzf_init="$(fzf --zsh 2>/dev/null)"
  if [[ -n $_fzf_init ]]; then
    eval "$_fzf_init"
  elif [[ -f "${HOME}/.fzf.zsh" ]]; then
    source "${HOME}/.fzf.zsh"
  fi
  unset _fzf_init
elif [[ -f "${HOME}/.fzf.zsh" ]]; then
  source "${HOME}/.fzf.zsh"
fi

# autojump is loaded by the oh-my-zsh `autojump` plugin (see omzsh.zsh); it does
# not need sourcing here.

# nvm is expensive to source (~300ms) and used to be sourced three times, which
# was roughly 900ms of a 1.25s startup. Shim the entry points and load it once,
# on first use.
export NVM_DIR="${HOME}/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  _nvm_load() {
    unfunction nvm node npm npx corepack yarn pnpm 2>/dev/null
    source "$NVM_DIR/nvm.sh"
    [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
  }
  for _cmd in nvm node npm npx corepack yarn pnpm; do
    eval "${_cmd}() { _nvm_load; ${_cmd} \"\$@\" }"
  done
  unset _cmd
fi

# Generated for envman. Do not edit.
[[ -s "${HOME}/.config/envman/load.sh" ]] && source "${HOME}/.config/envman/load.sh"

# Attach to tmux for interactive ssh sessions.
if [[ -z $TMUX && -n $SSH_CONNECTION ]]; then
  tmux new-session -A -s main
fi

# Amazon Q post block. Keep at the bottom of this file. macOS only.
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh"
